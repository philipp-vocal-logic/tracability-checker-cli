#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

run_tool() {
    if [[ -d .venv ]]; then
        uv run "$@"
    else
        "$@"
    fi
}

if [[ -f uv.lock ]]; then
    uv lock --check
fi

run_tool ruff check .
run_tool ruff format --check .

if [[ -f glossary.toml ]]; then
    run_tool glossary
fi

if [[ -f symbols.toml ]]; then
    run_tool symbol
fi

if [[ -f arch.toml ]]; then
    run_tool architecture
fi

if [[ -f traceability.toml ]]; then
    run_tool trace-check
fi

run_tool pytest

echo "All pre-commit checks passed."
